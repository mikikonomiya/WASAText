FROM node:20 AS builder

WORKDIR /app

# Copy package management files
# We assume the context is the project root, so we access webui/
COPY webui/package.json webui/yarn.lock webui/.yarnrc.yml ./
COPY webui/.yarn/ ./.yarn/

# Install dependencies
RUN yarn install

# Copy the rest of the frontend source code
COPY webui/ ./

# Build for production
RUN yarn run build-prod

# Final Stage: Nginx to serve the static files
FROM nginx:stable-alpine

# Copy the build output to Nginx html folder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY webui/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
